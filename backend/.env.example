# Copy this file to .env inside backend. Never upload .env to GitHub.
MONGODB_URI=mongodb+srv://DB_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=olga_portal
# Exact browser origins, with no paths or trailing slashes.
ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
FRONTEND_URL=http://localhost:4173/
SESSION_HOURS=8

# Optional password-reset email. Leave empty until you have an SMTP provider.
# Use STARTTLS on port 587, or SMTP_USE_SSL=true with port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Public Google OAuth web client ID (not a client secret).
GOOGLE_CLIENT_ID=

# GitHub OAuth App. Keep the client secret private.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
